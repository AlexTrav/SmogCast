# секреты (ключ OpenAQ и т.п.) – только в переменных окружения
.env
.env.*
!.env.example

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# frontend
node_modules/
dist/
*.local

# рисунки исследования собираются в папку отчёта (make -C research figures FIGURES=...)
research/figures/
model/figures/

# кэш прогонов моделей – воспроизводится командами make в model/
model/.cache/

# логи
*.log

# IDE и ОС
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
